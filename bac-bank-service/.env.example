PORT=3000
# Clave para llamar al microservicio (header x-api-key)
API_KEY=cambia-esto

# Credenciales BAC (NUNCA al repo; usa secret manager en produccion)
BAC_USER=
BAC_PASSWORD=
BAC_LOGIN_URL=https://www.sucursalelectronica.com/redir/showLogin.go

# Selectores (ajustalos con `npm run codegen`)
BAC_USER_SELECTOR=input[type="text"]:visible
BAC_PASS_SELECTOR=#pass
BAC_SUBMIT_SELECTOR=
# Elemento que solo existe con sesion iniciada (ej. boton "Salir"). Recomendado.
BAC_LOGGED_IN_SELECTOR=

# Navegador
SESSION_DIR=.session
ARTIFACTS_DIR=artifacts
HEADLESS=false
BROWSER_CHANNEL=chrome
TYPE_DELAY_MS=70
