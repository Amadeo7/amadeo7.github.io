# Servidor SMTP de Office 365
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# Cuenta que envía (buzón real de Office 365)
SMTP_USER=tu.cuenta@tudominio.com
# Contraseña o "contraseña de aplicación" (si tienes MFA)
SMTP_PASS=cambia-esto
# Remitente visible (debe ser el buzón o un alias con permiso "Enviar como")
MAIL_FROM="Mi Empresa <tu.cuenta@tudominio.com>"
# Tamaño máximo del PDF en MB
MAX_PDF_MB=10
PORT=3000
