# =====================================================================
# Todas las opciones configurables. Los valores mostrados son los
# defaults; las marcadas (obligatoria) no tienen default.
# =====================================================================

# ---- HTTP / ejecución ----
# IP en la que escucha la app (0.0.0.0 = todas las interfaces, 127.0.0.1 = solo local) y puerto
LISTEN_HOST=0.0.0.0
PORT=3000
# (obligatoria) Clave que deben enviar los clientes en el header x-api-key
API_KEY=cambia-esto-por-un-valor-largo-y-aleatorio
# Ejecución automática (cron de 6 campos con segundos). Vacío = solo manual por POST /receipts/process
# Ejemplo: días 1 y 16 a las 8:00 -> 0 0 8 1,16 * *
RECEIPTS_CRON=
TZ=America/Mexico_City
# Límites del GET /receipts
LIST_DEFAULT_LIMIT=100
LIST_MAX_LIMIT=500

# ---- Archivos de recibos ----
# Expresión regular del nombre de archivo; el primer grupo de captura es el código de empleado
RECEIPT_FILENAME_REGEX=^Recibo de pago (\d+)\.pdf$
MAX_PDF_MB=10

# ---- SFTP ----
# (obligatorias) SFTP_HOST, SFTP_USER, SFTP_DIR y SFTP_PASSWORD o SFTP_PRIVATE_KEY_PATH
SFTP_HOST=sftp.ejemplo.com
SFTP_PORT=22
SFTP_USER=usuario
SFTP_PASSWORD=
SFTP_PRIVATE_KEY_PATH=
SFTP_PASSPHRASE=
# Huella SHA-256 del servidor en hexadecimal (recomendado, evita suplantación)
SFTP_HOST_SHA256=
SFTP_READY_TIMEOUT_MS=20000
# Carpeta de donde se leen los recibos
SFTP_DIR=/recibos
# Carpeta a donde se mueve cada PDF tras enviarse. Dentro se crea una subcarpeta por fecha
# (AAAA-MM-DD) y el archivo se renombra con fecha, hora y hash para no pisar envíos anteriores.
# Vacío = <SFTP_DIR>/procesados
SFTP_PROCESSED_DIR=

# ---- API de empleados (una consulta por código de empleado) ----
# (obligatoria) URL con el marcador {code}, que se reemplaza por el código del nombre del archivo.
# Ejemplos: https://api.ejemplo.com/empleados/{code}   o   https://api.ejemplo.com/empleados?codigo={code}
EMPLOYEES_API_URL=https://api.ejemplo.com/empleados/{code}
# Autenticación: token (cabecera de abajo) o, si no hay token, usuario y contraseña (Basic)
EMPLOYEES_API_TOKEN=
EMPLOYEES_API_USER=
EMPLOYEES_API_PASSWORD=
# Cabecera y esquema que se usan con el token (esquema vacío = se envía el token tal cual)
EMPLOYEES_API_AUTH_HEADER=Authorization
EMPLOYEES_API_AUTH_SCHEME=Bearer
EMPLOYEES_API_TIMEOUT_MS=30000
# true = se envía el código sin ceros a la izquierda (00123 -> 123); false = tal como viene en el archivo
EMPLOYEES_API_STRIP_ZEROS=false
# Códigos HTTP que significan "empleado no existe" (separados por coma). Cualquier otro error = API no disponible
EMPLOYEES_API_NOT_FOUND_STATUS=404
# Ruta al empleado dentro del JSON (vacío si la respuesta ya es el objeto), p. ej. data o data.items
EMPLOYEES_API_RESPONSE_PATH=
EMPLOYEES_FIELD_CODE=codigo
EMPLOYEES_FIELD_NAME=nombre
EMPLOYEES_FIELD_EMAIL=correo
# Si la API falla (red, timeout, 5xx) este número de veces seguidas, se aborta la ejecución
EMPLOYEES_API_MAX_CONSECUTIVE_ERRORS=5

# ---- Office 365 (SMTP) ----
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
# false = STARTTLS (puerto 587); true = TLS directo (puerto 465)
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_TLS_MIN_VERSION=TLSv1.2
# (obligatorias) Buzón que envía y su contraseña (o contraseña de aplicación si hay MFA)
SMTP_USER=nomina@tudominio.com
SMTP_PASS=cambia-esto
# Remitente visible. Vacío = SMTP_USER
MAIL_FROM="Nómina <nomina@tudominio.com>"
# Pausa entre correos (Office 365 limita ~30/min por buzón)
SEND_DELAY_MS=2500

# ---- Contenido del correo ----
MAIL_SUBJECT=Tu recibo de pago
COMPANY_NAME=Mi Empresa
# Nombre a usar si la API no trae nombre del empleado
MAIL_DEFAULT_NAME=colaborador
# Plantillas propias (vacío = plantilla incluida). Variables: {{nombre}} y {{empresa}}
MAIL_TEMPLATE_HTML_PATH=
MAIL_TEMPLATE_TEXT_PATH=

# ---- Reporte final por correo ----
# Al terminar cada ejecución se envía un correo con lo enviado (con nombres de empleados) y lo que falló.
# Destinatarios separados por coma. Vacío = no se envía reporte
REPORT_TO=
REPORT_CC=
REPORT_SUBJECT=Reporte de envío de recibos
# false = el reporte no incluye los correos de los empleados (solo nombre y código)
REPORT_INCLUDE_EMAIL=true

# ---- Envíos que quedan a medias ----
# Si el proceso se cae mientras envía, no se sabe si el correo salió. Antes de reenviar se busca en
# Elementos enviados (requiere Graph). Si no aparece y no han pasado estos minutos, queda "uncertain"
# para revisión manual; sin Graph configurado nunca se reenvía solo.
UNCERTAIN_WINDOW_MIN=10

# ---- Temporal (orquestación de las ejecuciones) ----
# false = el bucle corre dentro del proceso, con RECEIPTS_CRON como programador.
# true  = cada ejecución es un workflow de Temporal (reanuda tras caídas, reintentos con backoff,
#         Schedule en lugar de cron). Requiere un servidor Temporal.
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# TLS simple. Se activa solo si defines alguna de las siguientes
TEMPORAL_TLS=false
# Servidor propio con certificado de una CA interna: ruta al certificado de la CA
TEMPORAL_TLS_CA_PATH=
# mTLS (el servidor exige certificado de cliente): ruta al certificado y a la llave, siempre juntas
TEMPORAL_TLS_CERT_PATH=
TEMPORAL_TLS_KEY_PATH=
# Nombre esperado en el certificado del servidor, si no coincide con el host de TEMPORAL_ADDRESS
TEMPORAL_TLS_SERVER_NAME=
# Temporal Cloud con API key (activa TLS automáticamente). El namespace es <nombre>.<id-de-cuenta>
TEMPORAL_API_KEY=
TEMPORAL_TASK_QUEUE=receipts-mail
# true = el worker corre en este proceso. false = córrelo aparte con `npm run start:worker`
TEMPORAL_WORKER_ENABLED=true
TEMPORAL_MAX_CONCURRENT_ACTIVITIES=1
# Límite de activities por segundo de la cola (0 = sin límite). Red de seguridad: el ritmo real lo marca SEND_DELAY_MS
TEMPORAL_ACTIVITIES_PER_SECOND=0
# Un Workflow ID fijo impide dos ejecuciones simultáneas (la segunda recibe 409)
TEMPORAL_WORKFLOW_ID=receipts-run
# Programación con Temporal Schedules (cron de 5 campos, zona = TZ). Ejemplo: días 1 y 16 a las 8:00 -> 0 8 1,16 * *
# Con TEMPORAL_ENABLED=true se ignora RECEIPTS_CRON
TEMPORAL_SCHEDULE_ID=receipts-schedule
TEMPORAL_SCHEDULE_CRON=
# Cada cuántos archivos el workflow continúa como uno nuevo (mantiene acotado su historial)
WORKFLOW_BATCH_SIZE=500
# Reintentos de cada activity ante fallos transitorios (espera inicial, se duplica hasta el máximo)
TEMPORAL_RETRY_ATTEMPTS=3
TEMPORAL_RETRY_INITIAL_SECONDS=5
TEMPORAL_RETRY_MAX_SECONDS=60
# El reporte espera más entre intentos para no duplicarse
TEMPORAL_REPORT_RETRY_ATTEMPTS=5
TEMPORAL_REPORT_RETRY_INITIAL_SECONDS=30

# ---- Verificación vía Microsoft Graph (opcional) ----
# Si AZURE_* se dejan vacías, los correos quedan "enviados" pero sin verificar
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_AUTH_URL=https://login.microsoftonline.com
GRAPH_BASE_URL=https://graph.microsoft.com/v1.0
GRAPH_SCOPE=https://graph.microsoft.com/.default
# Buzón donde buscar en Elementos enviados. Vacío = SMTP_USER
GRAPH_MAILBOX=
GRAPH_SENT_FOLDER=sentitems
GRAPH_TIMEOUT_MS=20000
VERIFY_MAX_ATTEMPTS=5
VERIFY_BATCH_SIZE=500

# ---- PostgreSQL ----
# Conexión por partes (recomendado: la contraseña puede llevar cualquier carácter)
DB_HOST=localhost
DB_PORT=5432
# (obligatorios) usuario y base
DB_USER=recibos
DB_PASSWORD=recibos
DB_NAME=recibos
DATABASE_SSL=false
# Nombre de la tabla de envíos (minúsculas, dígitos y _)
DB_TABLE=receipt_emails
# Opcional: URL completa. Si se define, reemplaza a DB_HOST/DB_PORT/DB_USER/DB_PASSWORD/DB_NAME
DATABASE_URL=

# ---- Solo Docker / docker-compose ----
# En docker-compose la app se conecta al servicio "db" por su nombre (DB_HOST se ignora ahí)
# y PostgreSQL se crea con DB_USER / DB_PASSWORD / DB_NAME.
NODE_VERSION=20
POSTGRES_VERSION=16
# Servidor Temporal de desarrollo: docker compose --profile temporal up (usa TEMPORAL_ADDRESS=temporal:7233)
TEMPORAL_VERSION=latest
TEMPORAL_UI_PORT=8233
