{
  "name": "mail-office365",
  "version": "1.0.0",
  "description": "Servicio NestJS que lee recibos PDF de un SFTP y los env\u00eda por correo (Office 365) a cada empleado",
  "private": true,
  "scripts": {
    "build": "nest build && node scripts/bundle-workflows.js",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "nest build && node --test --test-concurrency=1 test/*.test.js",
    "start:worker": "node dist/worker",
    "temporal:check": "node scripts/check-temporal.js"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/schedule": "^4.1.0",
    "@temporalio/activity": "1.24.0",
    "@temporalio/client": "1.24.0",
    "@temporalio/common": "1.24.0",
    "@temporalio/worker": "1.24.0",
    "@temporalio/workflow": "1.24.0",
    "cron": "3.2.1",
    "nodemailer": "^10.0.9",
    "pg": "^8.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ssh2-sftp-client": "^11.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@temporalio/testing": "1.24.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/nodemailer": "^6.4.15",
    "@types/pg": "^8.11.6",
    "@types/ssh2-sftp-client": "^9.0.4",
    "mailparser": "^3.7.1",
    "smtp-server": "^3.13.6",
    "typescript": "^5.5.0"
  }
}
